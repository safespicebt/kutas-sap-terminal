<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            android:background="@color/white">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SAP Sunucusuna Bağlanılamadı!"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Lütfen Wi-Fi ve yerel ağ erişiminizi kontrol edin."
                android:textColor="#666666"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tekrar Dene"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeUrl"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sunucu Adresini Değiştir" />
        </LinearLayout>
    </FrameLayout>

    <!-- Renkli ve İsimli Alt İşlem Çubuğu -->
    <LinearLayout
        android:id="@+id/layoutSapKeypad"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#1E272C"
        android:padding="3dp"
        android:gravity="center">

        <!-- GERİ (Kırmızı) -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_margin="2dp"
            android:text="GERİ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/btn_back_red" />

        <!-- LİSTE (Turuncu) -->
        <Button
            android:id="@+id/btnList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="2dp"
            android:text="LİSTE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/btn_list_amber" />

        <!-- ÇIKIŞ (Koyu Gri) -->
        <Button
            android:id="@+id/btnLogoff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="2dp"
            android:text="ÇIKIŞ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/btn_exit_gray" />

        <!-- YENİLE (Mavi) -->
        <Button
            android:id="@+id/btnReload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="2dp"
            android:text="YENİLE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/btn_reload_blue" />

        <!-- ONAY / ENTER (Yeşil) -->
        <Button
            android:id="@+id/btnEnter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:layout_margin="2dp"
            android:text="ONAY"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/btn_enter_green" />
    </LinearLayout>

</LinearLayout>
